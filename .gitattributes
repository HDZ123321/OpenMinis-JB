# Normalize line endings in the index to LF. The deps/*.sh scripts are
# executed on macOS by `#!/bin/bash`; a CRLF checkout there fails with
# "bad interpreter: /bin/bash^M". Windows checkouts of the Swift / shell
# sources must not rewrite them either.
* text=auto eol=lf

*.sh            text eol=lf
*.pbxproj       text eol=lf
*.xcconfig      text eol=lf
*.xcscheme      text eol=lf
*.plist         text eol=lf
*.entitlements  text eol=lf
*.swift         text eol=lf
*.json          text eol=lf
*.md            text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
*.js            text eol=lf
*.patch         text eol=lf
*.S             text eol=lf

# Binary assets must never be normalized or diffed as text.
*.png          binary
*.jpg          binary
*.jpeg         binary
*.pdf          binary
*.zip          binary
*.tar          binary
*.gz           binary
*.xz           binary
*.apk          binary
*.a            binary
*.tiktoken     binary
*.xcstrings    text eol=lf
